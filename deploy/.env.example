# Copiar como /opt/tendencias-pos/.env en el VPS (chmod 600). Nunca subir el .env real al repo.
# El despliegue reescribe TPOS_IMAGE con la imagen de cada commit.
TPOS_IMAGE=ghcr.io/TU_USUARIO/tendencias-pos/api:latest

POSTGRES_DB=tpos
POSTGRES_USER=tpos
# Generar con: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=CAMBIAR

# Versión mínima del cliente de escritorio aceptada por la API.
MIN_CLIENT_VERSION=0.1.0
